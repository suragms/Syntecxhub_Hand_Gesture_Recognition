# Copy to .env and set only values needed by a future implementation.
# This repository currently contains scaffolding only; no application reads this file yet.

# Select a local webcam by numeric OpenCV device index.
CAMERA_INDEX=0

# Optional display settings for a future camera preview.
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_FPS=30

# Keep all external side effects disabled unless a future implementation requires
# explicit opt-in. Recognizing a gesture must never enable these implicitly.
ENABLE_MEDIA_ACTIONS=false
ENABLE_VOLUME_ACTIONS=false

# Optional sensitivity values for a future gesture mapper.
GESTURE_CONFIDENCE_THRESHOLD=0.70
VOLUME_STEP_PERCENT=2
